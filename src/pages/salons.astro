---
import Base from '../layouts/Base.astro';
import Barcode from '../components/Barcode.astro';
import { BRANCHES, HOURS, STAFF } from '../data/site';
const list = Object.values(BRANCHES);
---
<Base title="Salons: Westgate and Allen's Nek" description="Find HAIRitage Salon99 in Roodepoort: Westgate Shopping Centre (Horizon View) and Allen's Nek Retail Park. Addresses, phone numbers and opening hours." hd="paper">
  <section class="head t-paper sec-bg" data-hd="paper">
    <div class="wrap">
      <p class="lbl" data-reveal>Roodepoort · open 7 days</p>
      <h1 class="d d-mega" data-lines>
        <span class="ln"><span>Two doors.</span></span>
        <span class="ln"><span class="laser">Same hands.</span></span>
      </h1>
    </div>
  </section>

  {list.map((b, i) => (
    <section class={`branch ${i % 2 ? 't-paper' : 't-ink'} sec-bg`} data-hd={i % 2 ? 'paper' : 'ink'} id={b.id}>
      <div class="wrap grid">
        <div class="name">
          <p class="lbl" data-reveal>Branch {i + 1} · {STAFF[b.id].length} on the team</p>
          <h2 class="d d-mega" data-lines><span class="ln"><span>{b.name}</span></span></h2>
        </div>
        <address class="addr" data-reveal>
          <p class="lbl">Address</p>
          {b.address.map((l) => <p class="a">{l}</p>)}
          <p class="muted where">{b.where}</p>
          <a class="btn btn--sm" href={b.map} target="_blank" rel="noopener"><span>Directions</span></a>
        </address>
        <div class="hrs" data-reveal data-delay="0.1">
          <p class="lbl">Hours</p>
          <ul>{HOURS.map(([d, h]) => <li><span>{d}</span><span class="mono">{h}</span></li>)}</ul>
        </div>
        <div class="act" data-reveal data-delay="0.2">
          <p class="lbl">Call or message</p>
          <a class="phone d d-l" href={`tel:${b.tel}`}>{b.phone}</a>
          <div class="row">
            <a class="btn btn--laser btn--sm" href={`/book/?branch=${b.id}`}><span>Book {b.name}</span></a>
            <a class="btn btn--sm" href={`https://wa.me/${b.wa}`} target="_blank" rel="noopener" data-no-transition><span>WhatsApp</span></a>
          </div>
        </div>
      </div>
      <div class="wrap"><Barcode seed={i + 3} bars={110} /></div>
    </section>
  ))}
</Base>

<style>
  .head{padding-top:calc(var(--hd) + clamp(2.5rem,6vw,5rem));padding-bottom:clamp(2.5rem,6vw,4rem)}
  .head h1{margin-top:1rem}
  .branch{padding-block:clamp(3.5rem,8vw,7rem) clamp(2rem,4vw,3rem);border-top:1px solid var(--line)}
  .branch.sec-bg{border-top:0}
  .name{grid-column:1 / -1;margin-bottom:clamp(2rem,5vw,4rem)}
  .name h2{margin-top:.8rem;font-size:clamp(4.4rem,19vw,20rem)}
  .addr,.hrs,.act{grid-column:span 4;display:grid;gap:.5rem;align-content:start;margin-bottom:clamp(2rem,5vw,4rem)}
  .addr .a{font-size:1.2rem;font-weight:500}
  .where{font-size:.95rem}
  .addr .btn{justify-self:start;margin-top:.8rem}
  .hrs ul{list-style:none;border-top:1px solid var(--line)}
  .hrs li{display:flex;justify-content:space-between;gap:1rem;padding:.7rem 0;border-bottom:1px solid var(--line)}
  .phone{text-decoration:none;font-size:clamp(2.6rem,5vw,4.6rem);transition:color .3s}
  .phone:hover{color:var(--laser)}
  .act .row{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:.6rem}
  @media(max-width:900px){.addr,.hrs,.act{grid-column:1 / -1}}
</style>
