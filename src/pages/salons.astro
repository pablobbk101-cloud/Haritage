---
import Base from '../layouts/Base.astro';
import { BRANCHES, HOURS, STAFF } from '../data/site';
const list = Object.values(BRANCHES);
---
<Base title="Salons: Westgate and Allen's Nek" description="Find HAIRitage Salon99 in Roodepoort: Westgate Shopping Centre (Horizon View) and Allen's Nek Retail Park. Addresses, phone numbers and opening hours." hd="paper">
  <section class="head">
    <div class="wrap">
      <h1 class="d d-mega">Two salons, one standard</h1>
      <p class="lede">Both are in Roodepoort and open seven days a week.</p>
    </div>
  </section>

  <section class="sec t-sand sec-bg pad">
    <div class="wrap two">
      {list.map((b) => (
        <article class="card branch" id={b.id}>
          <h2 class="d d-xl">{b.name}</h2>
          <p class="lbl">{STAFF[b.id].length} on the team</p>
          <address>
            {b.address.map((l) => <p>{l}</p>)}
            <p class="muted">{b.where}</p>
          </address>
          <ul class="hrs">{HOURS.map(([d, h]) => <li><span>{d}</span><span class="mono">{h}</span></li>)}</ul>
          <a class="phone d d-l" href={`tel:${b.tel}`}>{b.phone}</a>
          <div class="row">
            <a class="btn btn--primary" href={`/book/?branch=${b.id}`}>Book at {b.name}</a>
            <a class="btn" href={b.map} target="_blank" rel="noopener">Directions</a>
            <a class="btn" href={`https://wa.me/${b.wa}`} target="_blank" rel="noopener">WhatsApp</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .head{padding-block:clamp(2rem,5vw,3.5rem)}
  .head h1{margin-bottom:.8rem}
  .pad{padding-top:clamp(1.5rem,4vw,3rem)}
  .two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem}
  .branch{display:grid;gap:.9rem;align-content:start}
  address{font-style:normal;font-size:1.1rem}
  .hrs{list-style:none;border-top:1px solid var(--line)}
  .hrs li{display:flex;justify-content:space-between;gap:1rem;padding:.65rem 0;border-bottom:1px solid var(--line)}
  .phone{text-decoration:none;color:var(--accent)}
  .phone:hover{text-decoration:underline}
  .row{display:flex;flex-wrap:wrap;gap:.6rem}
  @media(max-width:860px){.two{grid-template-columns:minmax(0,1fr)}}
</style>
