---
import Base from '../layouts/Base.astro';
import { BRANCHES, STAFF } from '../data/site';
const total = STAFF.westgate.length + STAFF.allensnek.length;
---
<Base title="The team" description={`Meet the ${total} stylists, plaiters, locticians, barbers and nail techs across HAIRitage Salon99 Westgate and Allen's Nek in Roodepoort.`} hd="paper">
  <section class="head t-paper sec-bg" data-hd="paper">
    <div class="wrap">
      <p class="lbl" data-reveal>Stylists, plaiters, locticians, barbers, nail techs</p>
      <h1 class="d d-mega" data-lines>
        <span class="ln"><span>{total} pairs</span></span>
        <span class="ln"><span class="laser">of hands.</span></span>
      </h1>
      <p class="lede" data-reveal>The names and specialities below are the ones listed on each salon's booking page. Ask for a stylist by name when you book, or let the salon match you to the right hands.</p>
    </div>
  </section>

  {(['westgate', 'allensnek'] as const).map((id, i) => (
    <section class={`crew ${i ? 't-ink' : 't-bone'} sec-bg`} data-hd={i ? 'ink' : 'paper'}>
      <div class="wrap">
        <header>
          <h2 class="d d-xl" data-lines><span class="ln"><span>{BRANCHES[id].name}</span></span></h2>
          <p class="lbl">{STAFF[id].length} on the team</p>
        </header>
        <ul class="people">
          {STAFF[id].map((p) => (
            <li data-reveal>
              <a class="sweep person" href={`/book/?branch=${id}`}>
                <span class="d d-m">{p.name}</span>
                <span class="lbl">{p.role}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</Base>

<style>
  .head{padding-top:calc(var(--hd) + clamp(2.5rem,6vw,5rem));padding-bottom:clamp(2.5rem,6vw,4rem)}
  .head h1{margin:1rem 0 1.6rem}
  .crew{padding-block:clamp(3.5rem,8vw,7rem)}
  .crew header{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:clamp(1.5rem,4vw,3rem)}
  .people{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,250px),1fr));border-top:1px solid var(--line);border-left:1px solid var(--line)}
  .people li{border-right:1px solid var(--line);border-bottom:1px solid var(--line)}
  .person{display:grid;gap:.5rem;padding:1.1rem 1rem 1.2rem;min-height:8.2rem;align-content:space-between}
  .person .d{font-size:clamp(1.8rem,3vw,2.6rem)}
  .person .lbl{opacity:.75}
</style>
