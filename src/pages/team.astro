---
import Base from '../layouts/Base.astro';
import { BRANCHES, STAFF } from '../data/site';
const total = STAFF.westgate.length + STAFF.allensnek.length;
---
<Base title="The team" description={`Meet the ${total} stylists, plaiters, locticians, barbers and nail techs across HAIRitage Salon99 Westgate and Allen's Nek in Roodepoort.`} hd="paper">
  <section class="head">
    <div class="wrap">
      <h1 class="d d-mega">{total} pairs of hands</h1>
      <p class="lede">Names and specialities come from each salon's own booking page. Ask for a stylist by name when you book.</p>
    </div>
  </section>

  {(['westgate', 'allensnek'] as const).map((id, i) => (
    <section class={`crew ${i ? 't-sand' : 't-paper'} sec-bg`}>
      <div class="wrap">
        <header>
          <h2 class="d d-xl">{BRANCHES[id].name}</h2>
          <p class="lbl">{STAFF[id].length} on the team</p>
        </header>
        <ul class="people">
          {STAFF[id].map((p) => (
            <li>
              <a class="person card" href={`/book/?branch=${id}`}>
                <span class="av" aria-hidden="true">{p.name[0]}</span>
                <span class="nm">{p.name}</span>
                <span class="lbl">{p.role}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</Base>

<style>
  .head{padding-block:clamp(2rem,5vw,3.5rem) clamp(1rem,3vw,2rem)}
  .head h1{margin-bottom:.8rem}
  .crew{padding-block:clamp(2rem,5vw,3.5rem)}
  .crew header{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:.5rem 1rem;margin-bottom:1.4rem}
  .people{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,230px),1fr));gap:.8rem}
  .person{display:grid;grid-template-columns:auto minmax(0,1fr);grid-template-areas:'a n' 'a r';column-gap:.9rem;row-gap:.1rem;align-items:center;text-decoration:none;padding:.9rem 1rem;transition:border-color .2s var(--ease),transform .2s var(--ease)}
  .person:hover{border-color:var(--accent);transform:translateY(-2px)}
  .av{grid-area:a;width:2.8rem;height:2.8rem;border-radius:50%;background:var(--accent-soft);color:var(--accent-d);display:grid;place-items:center;font:600 1.15rem var(--f-d)}
  .nm{grid-area:n;font-weight:600;line-height:1.2}
  .person .lbl{grid-area:r;line-height:1.3;font-size:.84rem}
  @media(max-width:600px){
    .people{grid-template-columns:minmax(0,1fr)}
  }
</style>
