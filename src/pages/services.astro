---
import Base from '../layouts/Base.astro';
import { CATEGORIES, SERVICES, money, catStats } from '../data/site';

const groups = CATEGORIES.map((c) => ({ ...c, items: SERVICES.filter((s) => s.cat === c.id), min: catStats(c.id).min }));
const where = (b: string[]) => (b.length > 1 ? 'Both salons' : b[0] === 'westgate' ? 'Westgate only' : "Allen's Nek only");
---
<Base title="Services & prices" description={`All ${SERVICES.length} services and prices at HAIRitage Salon99: braids, locs, relaxers, wigs, nails, lashes and massage at Westgate and Allen's Nek, Roodepoort.`} hd="paper">
  <section class="head">
    <div class="wrap">
      <h1 class="d d-mega">Services and prices</h1>
      <p class="lede">{SERVICES.length} services from the salons' own lists. Tap a row to book it. No price means it is quoted in the chair.</p>
    </div>
  </section>

  <section class="list">
    <div class="ctrl" id="ctrl">
      <div class="wrap ctrl-in">
        <label class="sr" for="q">Search services</label>
        <input id="q" class="q" type="search" placeholder="Search knotless, gel, wig" autocomplete="off" enterkeyhint="search" />
        <div class="br" role="group" aria-label="Salon">
          <button class="chip" data-b="all" aria-pressed="true">Both salons</button>
          <button class="chip" data-b="westgate" aria-pressed="false">Westgate</button>
          <button class="chip" data-b="allensnek" aria-pressed="false">Allen's Nek</button>
        </div>
        <label class="sr" for="catSel">Category</label>
        <select id="catSel" class="catsel">
          <option value="all">All categories ({SERVICES.length})</option>
          {groups.map((g) => <option value={g.id}>{g.label} ({g.items.length})</option>)}
        </select>
        <div class="cats" role="group" aria-label="Category" >
          <button class="chip" data-cat="all" aria-pressed="true">All <span class="mono">{SERVICES.length}</span></button>
          {groups.map((g) => <button class="chip" data-cat={g.id} aria-pressed="false">{g.label} <span class="mono">{g.items.length}</span></button>)}
        </div>
      </div>
    </div>

    <div class="wrap body">
      <p class="lbl status" id="status" role="status" aria-live="polite">Showing all {SERVICES.length}</p>
      {groups.map((g) => (
        <details class="grp" data-grp={g.id} open>
          <summary>
            <h2 class="d d-l" id={`h-${g.id}`}>{g.label}</h2>
            <span class="gm"><span class="gc mono" data-count>{g.items.length}</span>{g.min ? <span class="gf">from R{g.min}</span> : null}</span>
            <span class="chev" aria-hidden="true"></span>
          </summary>
          <p class="muted gb">{g.blurb}</p>
          <ul>
            {g.items.map((s) => (
              <li data-cat={s.cat} data-b={s.branches.join(' ')} data-n={s.name.toLowerCase()}>
                <a class="srow" href={`/book/?svc=${s.id}`}>
                  <span class="sn">{s.name}</span>
                  <span class="sb lbl">{where(s.branches)}</span>
                  <span class="sp mono">{money(s.price, s.from)}</span>
                  <span class="sg">Book</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}
      <p class="empty" id="empty" hidden>
        <span class="d d-l">Nothing matches that.</span>
        <span>Try a shorter word, or clear the filters. Anything custom, ask the salon: Westgate 068 523 8088, Allen's Nek 072 997 4937.</span>
      </p>
    </div>
  </section>
</Base>

<style>
  .head{padding-block:clamp(2rem,5vw,3.5rem) clamp(1rem,3vw,2rem)}
  .head h1{margin-bottom:.8rem}
  .ctrl{position:sticky;top:var(--hd);z-index:40;background:var(--paper);border-block:1px solid var(--line)}
  .ctrl-in{display:grid;grid-template-columns:minmax(220px,1fr) auto;gap:.8rem 1.2rem;padding-block:.9rem}
  .q{width:100%;background:var(--card);border:1.5px solid var(--line);border-radius:var(--pill);padding:.75rem 1.2rem;min-height:3rem;font-size:1rem}
  .q::placeholder{color:var(--mute)}
  .q:focus-visible{border-color:var(--accent);outline-offset:2px}
  .br,.cats{display:flex;flex-wrap:wrap;gap:.45rem}
  .cats{grid-column:1 / -1;max-height:6.4rem;overflow:auto}
  .catsel{display:none}
  .chip{border:1.5px solid var(--line);background:var(--card);border-radius:var(--pill);padding:.45rem .95rem;min-height:2.5rem;font-size:.92rem;font-weight:500;transition:background-color .2s var(--ease),color .2s var(--ease),border-color .2s var(--ease)}
  .chip:hover{border-color:var(--ink)}
  .chip[aria-pressed="true"]{background:var(--ink);border-color:var(--ink);color:var(--paper)}
  .chip .mono{opacity:.6;margin-left:.2rem}
  .body{padding-block:1.4rem clamp(4rem,9vw,7rem)}
  .status{margin-bottom:1.4rem}
  .grp{margin-bottom:2.2rem}
  .grp summary{list-style:none;display:flex;align-items:baseline;gap:1rem;padding-bottom:.6rem;border-bottom:2px solid var(--ink);cursor:default}
  .grp summary::-webkit-details-marker{display:none}
  .grp summary h2{margin:0}
  .gm{display:flex;align-items:baseline;gap:.8rem;margin-left:auto;color:var(--mute);font-size:.92rem}
  .gc{font-weight:600;color:var(--ink)}
  .gf{white-space:nowrap}
  .chev{display:none}
  .gb{margin:.6rem 0 .3rem;font-size:.95rem}
  .grp ul{list-style:none}
  .grp[hidden],.grp li[hidden]{display:none}
  .srow{display:grid;grid-template-columns:minmax(0,1fr) 9rem 6rem 3.2rem;gap:1rem;align-items:center;padding:.85rem .6rem;border-bottom:1px solid var(--line);text-decoration:none;border-radius:var(--r-s);transition:background-color .2s var(--ease)}
  .srow:hover,.srow:focus-visible{background:var(--sand)}
  .sn{font-weight:500}
  .sp{text-align:right;font-weight:600}
  .sg{text-align:right;color:var(--accent);font-weight:600;opacity:0;transition:opacity .2s var(--ease)}
  .srow:hover .sg,.srow:focus-visible .sg{opacity:1}
  .sb{color:var(--mute);font-size:.88rem}
  .empty{display:grid;gap:1rem;padding:3rem 0}
  .empty[hidden]{display:none}

  @media(max-width:720px){
    .head{padding-top:1.4rem}
    .head .lede{display:none}
    .ctrl{position:static}
    .ctrl-in{grid-template-columns:minmax(0,1fr);gap:.7rem;padding-block:1rem}
    .br{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.4rem}
    .br .chip{min-height:2.9rem;padding:.4rem .2rem;text-align:center;font-size:.85rem}
    .cats{display:none}
    .catsel{display:block;width:100%;min-height:3rem;border:1.5px solid var(--line);background:var(--card);border-radius:var(--pill);padding:.5rem 1.1rem;font-weight:500}
    .body{padding-top:.6rem}
    .grp{margin-bottom:0;border-bottom:1px solid var(--line)}
    .grp summary{cursor:pointer;min-height:3.8rem;align-items:center;padding:.6rem 0;gap:.7rem;border-bottom:0}
    .grp summary h2{font-size:1.3rem}
    .gm{flex-direction:column;align-items:flex-end;gap:0;font-size:.82rem}
    .chev{display:block;width:.65rem;height:.65rem;border-right:2.5px solid var(--ink);border-bottom:2.5px solid var(--ink);rotate:45deg;margin:0 .3rem 0 .2rem;transition:rotate .25s var(--ease);flex:none}
    .grp[open] .chev{rotate:225deg}
    .gb{margin:0 0 .5rem}
    .srow{grid-template-columns:minmax(0,1fr) auto;gap:.1rem 1rem;padding:.85rem .2rem;min-height:3.6rem;align-items:start}
    .sn{font-size:1.02rem;line-height:1.3}
    .sb{grid-row:2;grid-column:1;font-size:.82rem}
    .sp{grid-row:1;grid-column:2}
    .sg{display:none}
  }
</style>

<script>
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('.grp li'));
  const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>('.grp'));
  const q = document.getElementById('q') as HTMLInputElement;
  const sel = document.getElementById('catSel') as HTMLSelectElement;
  const status = document.getElementById('status')!;
  const empty = document.getElementById('empty')!;
  const params = new URLSearchParams(location.search);
  const state = { q: '', b: 'all', cat: params.get('cat') || 'all' };
  const phone = matchMedia('(max-width:720px)');
  let wasFocus = false;

  const press = (sel: string, attr: string, val: string) =>
    document.querySelectorAll<HTMLElement>(sel).forEach((el) => el.setAttribute('aria-pressed', String(el.dataset[attr] === val)));

  function apply() {
    const term = state.q.trim().toLowerCase();
    let shown = 0;
    items.forEach((li) => {
      const ok =
        (state.cat === 'all' || li.dataset.cat === state.cat) &&
        (state.b === 'all' || (li.dataset.b || '').includes(state.b)) &&
        (!term || (li.dataset.n || '').includes(term));
      li.hidden = !ok;
      if (ok) shown++;
    });
    // phone: folded unless the visitor is searching or has chosen a category
    const focus = !!term || state.cat !== 'all';
    groups.forEach((g) => {
      const n = g.querySelectorAll('li:not([hidden])').length;
      g.hidden = n === 0;
      (g.querySelector('[data-count]') as HTMLElement).textContent = String(n);
      if (!phone.matches) g.open = true;
      else if (focus) g.open = true;
      else if (wasFocus) g.open = false;
    });
    wasFocus = focus;
    empty.hidden = shown > 0;
    status.textContent = shown === items.length ? `Showing all ${items.length}` : `Showing ${shown} of ${items.length}`;
    press('.cats .chip', 'cat', state.cat);
    press('.br .chip', 'b', state.b);
    sel.value = state.cat;
    const u = new URL(location.href);
    state.cat === 'all' ? u.searchParams.delete('cat') : u.searchParams.set('cat', state.cat);
    history.replaceState(null, '', u);
  }

  q.addEventListener('input', () => { state.q = q.value; apply(); });
  sel.addEventListener('change', () => {
    state.cat = sel.value; apply();
    if (state.cat !== 'all') document.querySelector(`[data-grp="${state.cat}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
  document.querySelector('.br')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-b]');
    if (b) { state.b = b.dataset.b!; apply(); }
  });
  document.querySelector('.cats')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-cat]');
    if (b) { state.cat = b.dataset.cat!; apply(); }
  });
  // desktop keeps every group open; phone folds them
  groups.forEach((g) => g.querySelector('summary')!.addEventListener('click', (e) => { if (!phone.matches) e.preventDefault(); }));
  phone.addEventListener('change', () => { wasFocus = false; groups.forEach((g) => (g.open = !phone.matches)); apply(); });
  if (phone.matches) groups.forEach((g) => (g.open = false));
  apply();
</script>
