---
import Base from '../layouts/Base.astro';
import { BRANCHES, CATEGORIES, HOURS, SERVICES, catStats } from '../data/site';

const total = SERVICES.length;
const cats = CATEGORIES.map((c) => ({ ...c, min: catStats(c.id).min }));
// logo load animation: the hair and faces fade in, then the barcode drops bar by bar, then the wordmark.
const BAR_TOP = 796, BAR_BOTTOM = 1036, X0 = 196, STRIP = 10;
const strips = Array.from({ length: Math.ceil((692 - X0) / STRIP) }, (_, i) => X0 + i * STRIP);
const steps = [
  ['Choose a service', 'Search the full price list or browse by category.'],
  ['Pick your stylist', 'See who does your style at your salon, or let us choose.'],
  ['Choose a time', 'Pick a day, then tap any free time slot.'],
];
---
<Base title="HAIRitage Salon99 | Hair & beauty in Roodepoort, book your slot online" hd="paper">
  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-copy">
        <h1 class="d d-mega"><span>Your hair.</span> <span>Your heritage.</span> <span class="accent">Your slot.</span></h1>
        <p class="lede">Book braids, locs, nails and more at Westgate or Allen's Nek.</p>
        <div class="cta-row">
          <a class="btn btn--primary" href="/book/">Book a slot</a>
          <a class="btn" href="/services/">See services</a>
        </div>
        <p class="lbl my-salon" id="mySalon" hidden>Your salon: <strong id="mySalonN"></strong>. <button type="button" class="link" id="chgSalon">Change</button></p>
      </div>
      <div class="hero-logo">
        <svg viewBox="0 0 884 1200" role="img" aria-label="HAIRitage Salon logo: two faces in an afro that sheds a barcode">
          <defs>
            <clipPath id="lg-top"><rect x="0" y="0" width="884" height={BAR_TOP} /></clipPath>
            <clipPath id="lg-zone"><rect x="0" y={BAR_TOP} width="884" height={BAR_BOTTOM - BAR_TOP} /></clipPath>
            <clipPath id="lg-word"><rect x="0" y={BAR_BOTTOM} width="884" height={1200 - BAR_BOTTOM} /></clipPath>
            {strips.map((x, i) => <clipPath id={`lg-s${i}`}><rect x={x} y={BAR_TOP} width={STRIP + 1} height={BAR_BOTTOM - BAR_TOP} /></clipPath>)}
          </defs>
          <g clip-path="url(#lg-top)"><use class="lg-top" href="#hs-logo-path" /></g>
          {strips.map((_, i) => <g clip-path={`url(#lg-s${i})`}><g class="lg-bar" style={`--i:${i}`} clip-path="url(#lg-zone)"><use href="#hs-logo-path" /></g></g>)}
          <g clip-path="url(#lg-word)"><use class="lg-word" href="#hs-logo-path" /></g>
        </svg>
      </div>
    </div>
  </section>

  <dialog class="sp" id="salonPick" aria-labelledby="sp-t">
    <div class="sp-in">
      <h2 class="d d-l" id="sp-t">Which salon are you booking?</h2>
      <div class="sp-list">
        {Object.values(BRANCHES).map((b) => (
          <a class="sp-opt" href={`/book/?branch=${b.id}`} data-salon={b.id}>
            <span class="d d-m">{b.name}</span>
            <span class="lbl">{b.address[0]}, {b.address[1]}</span>
            <span class="lbl"><span data-today>Open 7 days</span></span>
          </a>
        ))}
      </div>
      <button type="button" class="sp-skip link" id="spSkip">Just looking around</button>
    </div>
  </dialog>

  <section class="sec t-sand sec-bg">
    <div class="wrap">
      <h2 class="d d-xl h2" data-reveal>Book in three steps</h2>
      <ol class="steps" data-reveal>
        {steps.map(([t, p], i) => (
          <li class="card">
            <span class="n d">{i + 1}</span>
            <h3 class="d d-m">{t}</h3>
            <p class="muted">{p}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2 class="d d-xl h2" data-reveal>What we do</h2>
      <p class="lede" data-reveal>{total} services, priced straight from the salons' own lists.</p>
      <ul class="cats" data-reveal>
        {cats.map((c) => (
          <li><a class="cat" href={`/services/?cat=${c.id}`}><span class="cn">{c.label}</span>{c.min ? <span class="lbl">from R{c.min}</span> : <span class="lbl">Quoted</span>}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec t-sand sec-bg">
    <div class="wrap">
      <h2 class="d d-xl h2" data-reveal>Two salons in Roodepoort</h2>
      <div class="salons" data-reveal>
        {Object.values(BRANCHES).map((b) => (
          <article class="card salon">
            <h3 class="d d-l">{b.name}</h3>
            <p>{b.address[0]}, {b.address[1]}</p>
            <p class="muted">{b.where}</p>
            <p><a class="link" href={`tel:${b.tel}`}>{b.phone}</a></p>
            <a class="btn btn--primary" href={`/book/?branch=${b.id}`}>Book at {b.name}</a>
          </article>
        ))}
      </div>
      <p class="lbl hours" data-reveal>{HOURS.map(([d, h]) => `${d}: ${h}`).join('. ')}.</p>
    </div>
  </section>

  <section class="sec closing">
    <div class="wrap">
      <h2 class="d d-xl" data-reveal>Ready when you are.</h2>
      <a class="btn btn--primary" href="/book/" data-reveal>Book a slot</a>
    </div>
  </section>
</Base>

<style>
  .hero{padding-block:clamp(2rem,5vw,4.5rem) clamp(2.5rem,6vw,5rem)}
  .hero-in{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:clamp(1.5rem,5vw,4rem);align-items:center}
  .hero h1{margin-bottom:1.2rem}
  .hero h1 span{display:block}
  .cta-row{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.8rem}
  .my-salon{margin-top:1.2rem}
  .hero-logo{background:var(--accent-soft);border-radius:calc(var(--r) * 1.6);padding:clamp(1.5rem,4vw,3rem);display:grid;place-items:center;color:var(--ink)}
  .hero-logo svg{width:min(100%,360px);height:auto}
  /* load animation: hair fades in, barcode drops bar by bar, wordmark follows. Transform and opacity only. */
  .lg-top{animation:lgFade .7s var(--ease) both}
  .lg-bar{transform-box:view-box;transform-origin:0 796px;animation:lgDrop .8s var(--ease) both;animation-delay:calc(.45s + var(--i) * 16ms)}
  .lg-word{animation:lgFade .6s var(--ease) 1.7s both}
  @keyframes lgFade{from{opacity:0}to{opacity:1}}
  @keyframes lgDrop{from{transform:scaleY(0);opacity:.2}to{transform:scaleY(1);opacity:1}}
  @media(prefers-reduced-motion:reduce){.lg-top,.lg-bar,.lg-word{animation:none}}

  .steps{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-top:1.6rem}
  .steps .n{display:grid;place-items:center;width:2.6rem;height:2.6rem;border-radius:50%;background:var(--accent);color:var(--on-accent);font-size:1.2rem;margin-bottom:.9rem}
  .steps h3{margin-bottom:.3rem}

  .cats{list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,210px),1fr));gap:.7rem;margin-top:1.6rem}
  .cat{display:flex;flex-direction:column;gap:.1rem;background:var(--card);border:1px solid var(--line);border-radius:var(--r-s);padding:.9rem 1rem;min-height:4.2rem;text-decoration:none;transition:border-color .2s var(--ease),transform .2s var(--ease)}
  .cat:hover{border-color:var(--accent);transform:translateY(-2px)}
  .cn{font-weight:600}

  .salons{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1.6rem}
  .salon{display:grid;gap:.4rem;align-content:start}
  .salon h3{margin-bottom:.3rem}
  .salon .btn{justify-self:start;margin-top:.8rem}
  .hours{margin-top:1.2rem}

  .closing{text-align:center}
  .closing h2{margin-bottom:1.4rem}

  /* salon picker */
  .sp{border:0;border-radius:calc(var(--r) * 1.4);padding:0;max-width:min(92vw,520px);width:100%;margin:auto;background:var(--paper);color:var(--ink);box-shadow:0 24px 60px var(--shadow)}
  .sp::backdrop{background:color-mix(in srgb,var(--ink) 55%,transparent)}
  .sp-in{padding:clamp(1.4rem,4vw,2rem);display:grid;gap:1rem}
  .sp-list{display:grid;gap:.7rem}
  .sp-opt{display:grid;gap:.15rem;background:var(--card);border:1.5px solid var(--line);border-radius:var(--r);padding:1rem 1.1rem;text-decoration:none;min-height:4.5rem;transition:border-color .2s var(--ease)}
  .sp-opt:hover{border-color:var(--accent)}
  .sp-skip{justify-self:center;min-height:2.75rem;padding:.4rem 1rem}

  @media(max-width:860px){
    .hero-in{grid-template-columns:minmax(0,1fr)}
    .hero-logo{order:-1;padding:1.2rem}
    .hero-logo svg{width:min(60%,200px)}
    .steps,.salons{grid-template-columns:minmax(0,1fr)}
    .steps li{display:grid;grid-template-columns:auto minmax(0,1fr);column-gap:1rem}
    .steps .n{grid-row:span 2;margin:0}
  }
</style>

<script>
  const dlg = document.getElementById('salonPick') as HTMLDialogElement | null;
  const my = document.getElementById('mySalon') as HTMLElement | null;
  const NAMES: Record<string, string> = { westgate: 'Westgate', allensnek: "Allen's Nek" };
  const OPEN: Record<number, [number, number]> = { 0: [9, 16], 1: [9, 18], 2: [9, 18], 3: [9, 18], 4: [9, 18], 5: [9, 18], 6: [8, 17] };
  const get = (k: string, s = false) => { try { return (s ? sessionStorage : localStorage).getItem(k); } catch { return null; } };
  const set = (k: string, v: string, s = false) => { try { (s ? sessionStorage : localStorage).setItem(k, v); } catch {} };
  function showMine() {
    const id = get('hs-salon');
    if (my && id && NAMES[id]) { my.hidden = false; (document.getElementById('mySalonN') as HTMLElement).textContent = NAMES[id]; }
  }
  if (dlg) {
    const [o, c] = OPEN[new Date().getDay()];
    dlg.querySelectorAll('[data-today]').forEach((el) => (el.textContent = `Open today ${String(o).padStart(2, '0')}:00 to ${c}:00`));
    const open = () => { if (!dlg.open) dlg.showModal(); };
    dlg.addEventListener('close', showMine);
    dlg.querySelectorAll<HTMLAnchorElement>('[data-salon]').forEach((a) => a.addEventListener('click', () => set('hs-salon', a.dataset.salon!)));
    document.getElementById('spSkip')?.addEventListener('click', () => { set('hs-skip', '1', true); dlg.close(); });
    document.getElementById('chgSalon')?.addEventListener('click', open);
    showMine();
    if (!get('hs-salon') && !get('hs-skip', true)) setTimeout(open, 600);
  }
</script>
