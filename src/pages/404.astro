---
import Base from '../layouts/Base.astro';
import Barcode from '../components/Barcode.astro';
---
<Base title="Page not found" description="That page could not be scanned." hd="ink" noindex>
  <section class="nf t-ink sec-bg" data-hd="ink">
    <div class="wrap">
      <p class="lbl" data-reveal>Error 404</p>
      <h1 class="d d-mega" data-lines>
        <span class="ln"><span>Bar not</span></span>
        <span class="ln"><span class="laser">found.</span></span>
      </h1>
      <p class="lede" data-reveal>The scanner read that address and came back empty. Try the home page, or go straight to a slot.</p>
      <div class="cta" data-reveal data-delay="0.15">
        <a class="btn btn--laser" href="/book/"><span>Book a slot</span></a>
        <a class="btn" href="/"><span>Home</span></a>
        <a class="btn" href="/services/"><span>Services</span></a>
      </div>
      <Barcode seed={404} bars={120} />
    </div>
  </section>
</Base>

<style>
  .nf{min-height:100svh;padding-top:calc(var(--hd) + 4rem);padding-bottom:3rem;display:grid;align-items:center}
  .nf h1{margin:1rem 0 1.5rem}
  .cta{display:flex;flex-wrap:wrap;gap:.7rem;margin:2rem 0 3rem}
</style>
