---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page could not be found." hd="paper" noindex>
  <section class="nf">
    <div class="wrap">
      <h1 class="d d-mega">We can't find that page</h1>
      <p class="lede">Try the home page, or go straight to booking.</p>
      <div class="cta">
        <a class="btn btn--primary" href="/book/">Book a slot</a>
        <a class="btn" href="/">Home</a>
        <a class="btn" href="/services/">Services</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf{padding-block:clamp(3rem,10vw,7rem);min-height:60svh;display:grid;align-items:center}
  .nf h1{margin-bottom:1rem}
  .cta{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:1.8rem}
</style>
