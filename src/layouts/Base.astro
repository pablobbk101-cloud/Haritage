---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/global.css';
import logoRaw from '../../public/img/logo.svg?raw';
import { BRANCHES, HOURS, SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  hd?: 'ink' | 'paper';
  noindex?: boolean;
}
const { title, description = SITE.description, hd = 'paper', noindex = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const fullTitle = path === '/' ? title : `${title} | ${SITE.short} Salon99`;
const logoPath = (logoRaw.match(/ d="([^"]+)"/) || [])[1] || '';
const nav = [
  { href: '/services/', label: 'Services' },
  { href: '/book/', label: 'Book' },
  { href: '/salons/', label: 'Salons' },
  { href: '/team/', label: 'Team' },
];
const here = (href: string) => path.replace(/\/$/, '') === href.replace(/\/$/, '');
const ld = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: SITE.name,
  url: Astro.site?.href,
  description: SITE.description,
  image: ogImage,
  priceRange: 'R30 to R1400',
  areaServed: 'Roodepoort, Johannesburg',
  department: Object.values(BRANCHES).map((b) => ({
    '@type': 'HairSalon',
    name: b.full,
    telephone: b.tel,
    address: { '@type': 'PostalAddress', streetAddress: b.address.slice(0, 2).join(', '), addressLocality: 'Roodepoort', addressRegion: 'Gauteng', addressCountry: 'ZA' },
    openingHoursSpecification: [
      { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '18:00' },
      { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '17:00' },
      { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '09:00', closes: '16:00' },
    ],
  })),
};
---
<!doctype html>
<html lang="en-ZA" data-hd={hd}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#fbf7f1" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script is:inline>
    (function () {
      var d = document.documentElement;
      d.classList.add('js');
      try {
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduce && !sessionStorage.getItem('hs-seen')) d.classList.add('loading');
        sessionStorage.setItem('hs-seen', '1');
      } catch (e) {}
    })();
  </script>
  <noscript><style>.js [data-reveal]{opacity:1!important;translate:0 0!important}.loader{display:none!important}</style></noscript>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
    <defs><path id="hs-logo-path" fill="currentColor" fill-rule="evenodd" d={logoPath} /></defs>
  </svg>

  <div class="loader" aria-hidden="true">
    <svg class="ld-mark" viewBox="0 1040 884 150"><use href="#hs-logo-path" /></svg>
    <div class="ld-bars">{Array.from({ length: 28 }).map((_, i) => <i style={`--i:${i};--h:${42 + ((i * 37) % 58)}%`} />)}</div>
  </div>

  <header class="hd" id="hd">
    <div class="wrap hd-in">
      <a href="/" aria-label="HAIRitage Salon home">
        <svg class="wm" viewBox="0 1040 884 150" role="img" aria-label="HAIRitage Salon"><use href="#hs-logo-path" /></svg>
      </a>
      <nav aria-label="Main">
        {nav.filter((n) => n.href !== '/book/').map((n) => (
          <a href={n.href} aria-current={here(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
        <a class="btn btn--primary btn--sm" href="/book/">Book a slot</a>
        <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="mnav">Menu</button>
      </nav>
    </div>
  </header>

  <div class="mnav" id="mnav" aria-label="Menu">
    <div>
      <a class="big" href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
      {nav.map((n) => <a class="big" href={n.href} aria-current={here(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </div>
    <div>
      <p><a class="tel" href={`tel:${BRANCHES.westgate.tel}`}>Westgate {BRANCHES.westgate.phone}</a></p>
      <p><a class="tel" href={`tel:${BRANCHES.allensnek.tel}`}>Allen's Nek {BRANCHES.allensnek.phone}</a></p>
    </div>
  </div>

  <main id="main"><slot /></main>

  <footer class="ft">
    <div class="wrap">
      <div class="cols">
        <div>
          <h3>{BRANCHES.westgate.name}</h3>
          <p>{BRANCHES.westgate.address.join(', ')}</p>
          <p>{BRANCHES.westgate.where}</p>
          <p><a href={`tel:${BRANCHES.westgate.tel}`}>{BRANCHES.westgate.phone}</a></p>
        </div>
        <div>
          <h3>{BRANCHES.allensnek.name}</h3>
          <p>{BRANCHES.allensnek.address.join(', ')}</p>
          <p><a href={`tel:${BRANCHES.allensnek.tel}`}>{BRANCHES.allensnek.phone}</a></p>
        </div>
        <div>
          <h3>Hours, both salons</h3>
          <ul>{HOURS.map(([d, h]) => <li>{d}: {h}</li>)}</ul>
        </div>
        <div>
          <h3>Pages</h3>
          <ul>
            <li><a href="/services/">Services and prices</a></li>
            <li><a href="/book/">Book a slot</a></li>
            <li><a href="/salons/">Salons</a></li>
            <li><a href="/team/">Team</a></li>
          </ul>
        </div>
      </div>
      <div class="credit">
        <span>© {new Date().getFullYear()} HAIRitage Salon99, Roodepoort</span>
        <span>Concept site by <a href={SITE.credit.url}>{SITE.credit.name}</a>, {SITE.credit.phone}</span>
      </div>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var d = document.documentElement;
      if (!d.classList.contains('loading')) return;
      var t0 = performance.now();
      function lift() {
        if (d.classList.contains('lift')) return;
        d.classList.add('lift');
        setTimeout(function () { d.classList.remove('loading', 'lift'); }, 900);
      }
      function ready() { setTimeout(lift, Math.max(0, 1500 - (performance.now() - t0))); }
      if (document.readyState === 'complete') ready(); else addEventListener('load', ready);
      setTimeout(lift, 3500);
    })();
  </script>
  <script>
    import '../scripts/engine';
  </script>
</body>
</html>
